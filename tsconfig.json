{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "strictNullChecks": true,
    "allowJs": true,
    "paths": {
      // TODO: Add the following shortcuts

      "@components/*": ["src/components/*"],

      // "@layouts/*": ["src/layouts/*"],
      // "@images/*": ["src/images/*"],

      "@styles/*": ["src/styles/*"],
      "@utils/*": ["src/utils/*"]
    },
    "ignoreDeprecations": "6.0"
  }
}
