---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { Post } from '@utils/types';
import { postCategories } from '@utils/types';
import { mapPostToPostLink, sortPostsDesc, generateSlug } from '@utils/scripts';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import TaxonomyTitle from '@components/page-title/TaxonomyTitle.astro';
import PostList from '@components/feed/PostList.astro';
import ExploreTheGarden from '@components/call-to-action/ExploreTheGarden.astro';

export const getStaticPaths = (async () => {
  const posts: Post[] = await getCollection(
    'posts',
    ({ data }) => !data.isDraft
  ).then((response) => sortPostsDesc(response));
  return postCategories.map((category) => {
    const categorySlug: string = generateSlug(category);
    const filteredPosts: Post[] = posts.filter(
      (post) => post.data.category === category
    );
    return {
      params: { categorySlug },
      props: {
        categoryName: category,
        posts: filteredPosts.map((post) => mapPostToPostLink(post, 'post')),
      },
    };
  });
}) satisfies GetStaticPaths;

const { posts, categoryName } = Astro.props;
---

<BaseWrapper pageTitle=`Browsing posts by category: ${categoryName}`>
  <TaxonomyTitle slot="page-title" taxonomy={categoryName} type="category" />
  <PostList
    posts={posts}
    showLog={false}
    title="Explore the Garden"
    subtitle="Begin reading."
    showHeading={false}
  />
  <ExploreTheGarden />
</BaseWrapper>
