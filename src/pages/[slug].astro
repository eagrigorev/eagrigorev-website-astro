---
import type { GetStaticPaths } from 'astro';
import type { Post } from '@utils/types';
import { getSortedPosts } from '@scripts/getPosts';
import { render } from 'astro:content';
import { generateGraph } from '@scripts/generateGraph';
import SiteWrapper from '@layouts/SiteWrapper.astro';
import PageHeader from '@components/navigation/PageHeader.astro';
import PageTitleWithMeta from '@components/page-title/PageTitleWithMeta.astro';
import ContentWrapper from '@layouts/ContentWrapper.astro';
import TagCloud from '@components/markdown-blocks/TagCloud.astro';
import PostList from '@components/posts/PostList.astro';
import RandomPost from '@components/posts/RandomPost.astro';

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const { backlinksMap } = await generateGraph();
const backlinks: Post[] = backlinksMap[post.data.slug] || [];
---

<SiteWrapper pageTitle={post.data.title}>
  <PageHeader slot="header" />
  <PageTitleWithMeta slot="page-title" post={post} />
  <ContentWrapper>
    <Content />
  </ContentWrapper>
  <TagCloud tags={post.data.tags} />
  <PostList
    posts={backlinks}
    title="Backlinks"
    description="Read more."
    url="/"
  />
  <RandomPost />
</SiteWrapper>
