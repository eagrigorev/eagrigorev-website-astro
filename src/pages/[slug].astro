---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { BacklinkRef } from '@utils/types';
import { customTypography } from '@utils/scripts';
import { getGardenGraph } from '@utils/generateGraph';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import BackToIndex from '@components/BackToIndex.astro';
import PageTitle from '@components/PageTitle.astro';
import ContentWrapper from '@layouts/ContentWrapper.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.isDraft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const { backlinksMap } = await getGardenGraph();
const backlinks: BacklinkRef[] = backlinksMap[post.data.slug] || [];
---

<BaseWrapper pageTitle={post.data.title}>
  <BackToIndex slot="header" />
  <PageTitle slot="header" post={post} />
  <div>
    <ContentWrapper>
      <Content components={customTypography} />
    </ContentWrapper>
    <p>THere are also tags assigned:</p>
    {
      post.data.tags.map((tag) => (
        <a href={`/tag/${tag.replace(/\s+/g, '-')}`}>{tag}</a>
      ))
    }

    <h3>Links pointing to this note</h3>
    {
      backlinks.length > 0 ? (
        <ul>
          {backlinks.map((link) => (
            <li>
              <a href={`/${link.slug}`}>{link.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p>No other notes link here yet.</p>
      )
    }
  </div>
</BaseWrapper>
