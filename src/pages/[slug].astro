---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { PostLink } from '@utils/types';
import { mapPostToPostLink, sortPostsDesc } from '@utils/scripts';
import { getGardenGraph } from '@utils/generateGraph';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import BackToIndex from '@components/navigation/BackToIndex.astro';
import PageTitle from '@components/page-title/PageTitle.astro';
import ContentWrapper from '@layouts/ContentWrapper.astro';
import TagCloud from '@components/navigation/TagCloud.astro';
import PostList from '@components/feed/PostList.astro';
import ExploreTheGarden from '@components/call-to-action/ExploreTheGarden.astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.isDraft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const { backlinksMap } = await getGardenGraph();
const backlinks: PostLink[] = backlinksMap[post.data.slug] || [];
const relatedPosts: PostLink[] = await getCollection(
  'posts',
  ({ data }) =>
    !data.isDraft &&
    data.category === post.data.category &&
    data.title !== post.data.title
)
  .then((response) => sortPostsDesc(response))
  .then((response) =>
    response.map((post) => {
      return mapPostToPostLink(post, 'related');
    })
  );
const morePosts = [...backlinks, ...relatedPosts];
---

<BaseWrapper pageTitle={post.data.title}>
  <BackToIndex slot="header" />
  <PageTitle slot="page-title" post={post} />
  <ContentWrapper>
    <Content />
  </ContentWrapper>
  <TagCloud tags={post.data.tags} />
  <PostList
    posts={morePosts}
    showLog={false}
    title="Backlinks & Related Posts"
    subtitle="Read more."
  />
  <ExploreTheGarden />
</BaseWrapper>
