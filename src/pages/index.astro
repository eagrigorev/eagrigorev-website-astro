---
import '@styles/main.scss';
import { getCollection } from 'astro:content';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import HeaderNavigation from '@components/HeaderNavigation.astro';
import Intro from '@components/Intro.astro';
import FeaturedGrid from '@components/FeaturedGrid.astro';
import RandomPost from '@components/RandomPost.astro';
import PostList from '@components/PostList.astro';

const posts = await getCollection('posts', ({ data }) => !data.isDraft);

// TODO: add types and components
---

<BaseWrapper pageTitle="Gardens & Ruins">
  <HeaderNavigation slot="header" />
  <Intro slot="header" />
  <div slot="main">
    <FeaturedGrid posts={posts.slice(0, 6)} />
    <PostList posts={posts} showLog={true} />
    <section>
      <RandomPost posts={posts} />
    </section>
  </div>
  <p slot="footer">Test footer</p>
</BaseWrapper>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
