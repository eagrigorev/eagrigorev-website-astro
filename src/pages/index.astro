---
import '@styles/main.scss';
import { getCollection } from 'astro:content';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import HeaderNavigation from '@components/HeaderNavigation.astro';
import Intro from '@components/Intro.astro';
import FeaturedPostCard from '@components/FeaturedPostCard.astro';
import RandomPost from '@components/RandomPost.astro';

const posts = await getCollection('posts', ({ data }) => !data.isDraft);

// TODO: add types and components
---

<BaseWrapper pageTitle="Gardens & Ruins">
  <HeaderNavigation slot="header" />
  <Intro slot="header" />
  <div slot="main">
    {posts.map((post) => <FeaturedPostCard post={post} />)}
    <section>
      <RandomPost posts={posts} />
    </section>
  </div>
  <p slot="footer">Test footer</p>
</BaseWrapper>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
