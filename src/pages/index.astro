---
import '@styles/main.scss';
import { getCollection } from 'astro:content';
import Head from '@components/Head.astro';

const posts = await getCollection('posts', ({ data }) => !data.isDraft);

// TODO: add types and components
---

<html lang="en">
  <Head pageTitle="Gardens & Ruins" />
  <body>
    <header>
      <h1>Website title</h1>
    </header>
    <main>
      <p>Test main</p>
      {
        posts.map((post) => (
          <div>
            <h2>{post.data.title}</h2>
            <p>{post.data.category}</p>
            <a href={post.data.slug}>Read more</a>
          </div>
        ))
      }
    </main>
    <footer class="sticky-footer">
      <p>Test footer</p>
    </footer>
  </body>
</html>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
