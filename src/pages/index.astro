---
import type { Post, PostLink } from '@utils/types';
import { getCollection } from 'astro:content';
import { mapPostToPostLink, sortPostsDesc } from '@utils/scripts';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import FeaturedGrid from '@components/feed/FeaturedGrid.astro';
import RandomPost from '@components/call-to-action/RandomPost.astro';
import PostList from '@components/feed/PostList.astro';

const posts: Post[] = await getCollection('posts', ({ data }) => !data.isDraft);
const sortedPosts: Post[] = sortPostsDesc(posts);
const featuredPosts: Post[] = sortedPosts
  .filter((post: Post) => post.data.isFeatured)
  .slice(0, 6);
const recentPosts: PostLink[] = sortedPosts
  .filter((post: Post) => !post.data.isFeatured)
  .map((post: Post) => {
    return mapPostToPostLink(post, 'post');
  })
  .slice(0, 10);
---

<BaseWrapper pageTitle="Gardens & Ruins">
  <FeaturedGrid posts={featuredPosts} />
  <PostList
    posts={recentPosts}
    showLog={true}
    title="Explore the Garden"
    link="/"
    subtitle="Begin reading."
  />
  <RandomPost posts={posts} />
</BaseWrapper>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
