---
import '@styles/main.scss';
import { getCollection } from 'astro:content';
import BaseWrapper from '@layouts/BaseWrapper.astro';

const posts = await getCollection('posts', ({ data }) => !data.isDraft);

// Map down to a lightweight array of just slugs and titles for the browser script
const randomizerPool = posts.map((post) => ({
  slug: post.data.slug,
  title: post.data.title,
}));

// TODO: add types and components
---

<BaseWrapper pageTitle="Gardens & Ruins">
  <h1 slot="header">Website title</h1>
  <div slot="main">
    <p>Test main</p>
    {
      posts.map((post) => (
        <div>
          <h2>{post.data.title}</h2>
          <p>{post.data.category}</p>
          <a href={`/${post.data.slug}`}>Read more</a>
        </div>
      ))
    }
    <section style="background: #eee; padding: 20px; margin: 20px 0;">
      <h2>🎲 Serendipity</h2>
      <p>Don't know where to start? Let the garden choose a path for you:</p>

      <a
        id="random-walk-btn"
        href="#"
        style="font-weight: bold; font-size: 1.2rem;"
      >
        ✨ Take a Random Stroll...
      </a>
    </section>
  </div>
  <p slot="footer">Test footer</p>
</BaseWrapper>

<script define:vars={{ randomizerPool }}>
  // 1. Double check that we actually have notes to pick from
  if (randomizerPool && randomizerPool.length > 0) {
    const button = document.getElementById('random-walk-btn');

    // 2. Pick a random item from the array
    const randomNote =
      randomizerPool[Math.floor(Math.random() * randomizerPool.length)];

    // 3. Update the anchor tag's destination and text
    // Since your permalinks are flat root urls (/[slug]), we just link directly to the slug
    button.href = `/${randomNote.slug}`;
    button.innerHTML = `✨ Stroll into: "${randomNote.title}"`;
  }
</script>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
