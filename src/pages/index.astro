---
import type { Post } from '@utils/types';
import { SITE } from '@utils/const';
import { getFeaturedPosts, getRecentPosts } from '@scripts/getPosts';
import SiteWrapper from '@layouts/SiteWrapper.astro';
import PostGrid from '@components/posts/PostGrid.astro';
import PostList from '@components/posts/PostList.astro';
import RandomPost from '@components/posts/RandomPost.astro';

const featuredPosts: Post[] = await getFeaturedPosts();
const recentPosts: Post[] = await getRecentPosts();

// TODO: Add links
---

<SiteWrapper pageTitle={SITE.TITLE}>
  <PostGrid posts={featuredPosts} />
  <PostList
    posts={recentPosts}
    title="Explore the Garden"
    description="Begin reading."
    url="/"
  />
  <RandomPost />
</SiteWrapper>
