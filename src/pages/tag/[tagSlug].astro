---
import type { Post } from '@utils/types';
import { getCollection } from 'astro:content';
import { generateSlug, mapPostToPostLink, sortPostsDesc } from '@utils/scripts';
import BaseWrapper from '@layouts/BaseWrapper.astro';
import TaxonomyTitle from '@components/page-title/TaxonomyTitle.astro';
import PostList from '@components/feed/PostList.astro';
import ExploreTheGarden from '@components/call-to-action/ExploreTheGarden.astro';

export async function getStaticPaths() {
  const posts: Post[] = await getCollection(
    'posts',
    ({ data }) => !data.isDraft
  ).then((response) => sortPostsDesc(response));
  const uniqueTags: string[] = [
    ...new Set(posts.flatMap((post) => post.data.tags)),
  ];
  return uniqueTags.map((tag: string) => {
    const tagSlug = generateSlug(tag);
    const filteredPosts: Post[] = posts.filter((post) =>
      post.data.tags.includes(tag)
    );
    return {
      params: { tagSlug },
      props: {
        tagName: tag,
        posts: filteredPosts.map((post) => mapPostToPostLink(post, 'post')),
      },
    };
  });
}

const { tagName, posts } = Astro.props;
---

<BaseWrapper pageTitle=`Browsing posts by tag: ${tagName}`>
  <TaxonomyTitle slot="page-title" taxonomy={tagName} type="tag" />
  <PostList
    posts={posts}
    showLog={false}
    title="Explore the Garden"
    subtitle="Begin reading."
    showHeading={false}
  />
  <ExploreTheGarden />
</BaseWrapper>
