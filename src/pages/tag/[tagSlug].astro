---
import { getCollection } from 'astro:content';
import { generateSlug } from '@utils/scripts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.isDraft);
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return uniqueTags.map((tag) => {
    const tagSlug = generateSlug(tag);
    const filteredPosts = posts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tagSlug },
      props: { tagName: tag, posts: filteredPosts },
    };
  });
}

const { tagName, posts } = Astro.props;

// TODO: Add everything here
---

<div>
  <p>{`Here go posts by tag ${tagName}`}</p>
  {
    posts.map((post) => (
      <div>
        <h2>{post.data.title}</h2>
        <p>{post.data.category}</p>
        <a href={`/${post.data.slug}`}>Read more</a>
      </div>
    ))
  }
</div>
