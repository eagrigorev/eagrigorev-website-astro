---
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import { sortPostsDesc } from '@utils/scripts';
import BigNavLayout from '@layouts/BigNavLayout.astro';
import Intro from '@components/Intro.astro';
import PostGrid from '@components/PostGrid.astro';
import Pagination from '@components/Pagination.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts');
  const categories: string[] = Array.from(
    new Set(posts.map((post) => post.data.category.toLowerCase()))
  );
  return categories.flatMap((category) => {
    const categoryPosts = posts.filter(
      (post) => post.data.category.toLowerCase() === category
    );
    return paginate(sortPostsDesc(categoryPosts), {
      params: { category },
      props: { category },
      pageSize: 3,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'posts'>>;
  category: string;
}

const { page, category }: Props = Astro.props;
---

<BigNavLayout pageTitle="Gardens & Ruins">
  <Intro slot="header" introType="category" introText={category} />
  {category}
  <PostGrid slot="main" posts={page.data} />
  <Pagination slot="main" prevPage={page.url.prev} nextPage={page.url.next} />
</BigNavLayout>
