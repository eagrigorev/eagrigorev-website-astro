---
import Head from '@components/Head.astro';
import HeaderNavigation from '@components/HeaderNavigation.astro';
import Intro from '@components/Intro.astro';
import FooterNavigation from '@components/FooterNavigation.astro';

interface Props {
  pageTitle: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
---

<html lang="en">
  <Head pageTitle={pageTitle} description={description} />
  <body class="container">
    <header>
      <slot name="header">
        <HeaderNavigation />
        <Intro />
      </slot>
    </header>
    <main>
      <slot />
    </main>
    <footer class="sticky-footer">
      <slot name="footer"><FooterNavigation /></slot>
    </footer>
  </body>
</html>

<style lang="scss">
  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-height: 100vh;
  }

  main {
    align-items: center;
    display: flex;
    flex-direction: column;
  }

  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    max-width: 600px;
    width: 100%;
  }
</style>
