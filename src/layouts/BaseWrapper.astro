---
import '@styles/main.scss';
import HeadMetadata from '@components/HeadMetadata.astro';
import GlobalHeader from '@components/navigation/GlobalHeader.astro';
import Intro from '@components/Intro.astro';
import GlobalFooter from '@components/navigation/GlobalFooter.astro';

interface Props {
  pageTitle: string;
  description?: string;
}

const { pageTitle, description } = Astro.props;
---

<html lang="en">
  <HeadMetadata pageTitle={pageTitle} description={description} />
  <body class="container">
    <header>
      <slot name="header">
        <GlobalHeader />
      </slot>
      <slot name="page-title">
        <Intro />
      </slot>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <slot name="footer">
        <GlobalFooter />
      </slot>
    </footer>
  </body>
</html>

<style lang="scss">
  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    margin: 0;
    min-height: 100vh;
  }

  header {
    align-items: center;
    display: flex;
    flex-direction: column;
    max-width: 600px;
    width: 100%;
  }

  main {
    align-items: center;
    display: flex;
    flex-direction: column;
  }

  footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    max-width: 600px;
    width: 100%;
  }

  .container {
    align-items: center;
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-width: 77.5rem; // 1240px
    padding-inline: var(--space-24-40);
  }
</style>
