---
import '@styles/main.scss';
import Head from '@components/Head.astro';

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<html lang="en">
  <Head pageTitle={pageTitle} />
  <body>
    <header>Test</header>
    <main>Test</main>
    <footer class="sticky-footer"></footer>
  </body>
</html>

<style lang="scss">
  .sticky-footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }
</style>
