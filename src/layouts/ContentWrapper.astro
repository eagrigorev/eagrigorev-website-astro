<style lang="scss">
  @use '../styles/partials/typography' as *;

  .content {
    align-items: center;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-96-120);
    max-width: 960px;
    width: 100%;

    :global(p:not([class])) {
      @include text-serif-primary;
      font-size: var(--step-0);
      max-width: 600px;
    }

    :global(h2) {
      @include heading-serif-primary;
      font-size: var(--step-3);
      max-width: 600px;
      width: 100%;
    }

    :global(h3) {
      @include heading-serif-primary;
      font-size: var(--step-2);
      max-width: 600px;
      width: 100%;
    }

    :global(a) {
      @include link-accent-to-text-underline;
    }
  }
</style>
