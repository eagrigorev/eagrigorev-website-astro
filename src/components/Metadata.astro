---
import { SITE } from '@utils/const';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;

const description: string = `${SITE.TITLE} — ${SITE.DESCRIPTION} by ${SITE.AUTHOR}`;

// TODO: Upload favicon, add RSS
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- <link
    rel="alternate"
    type="application/rss+xml"
    title="Evgenii Grigorev"
    href="/rss.xml"
  /> -->
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{`${pageTitle} · ${SITE.AUTHOR}`}</title>
<meta name="title" content={`${pageTitle} · ${SITE.AUTHOR}`} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<Analytics />
<SpeedInsights />
