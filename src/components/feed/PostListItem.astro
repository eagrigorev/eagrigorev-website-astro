---
import type { Post } from '@utils/types';
import { formatDate } from '@utils/scripts';

interface Props {
  post: Post;
  type: 'post' | 'related' | 'mention';
}

const { post, type } = Astro.props;
---

<li class="post-item">
  <p class="post-item__title">
    {
      type === 'post'
        ? null
        : type === 'mention'
          ? 'Mentioned in: '
          : 'Related: '
    }<a class="post-item__title-link" href={post.data.slug}>{post.data.title}</a
    >
  </p>
  <p class="post-item__meta">{formatDate(post.data.date)}</p>
</li>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .post-item {
    align-items: center;
    display: flex;
    justify-content: space-between;

    &__title {
      @include heading-serif-primary;
      font-size: var(--step-0);
    }

    &__title-link {
      @include link-text-to-accent;
    }

    &__meta {
      @include text-sans-serif-secondary;
      font-size: var(--step--1);
    }
  }
</style>
