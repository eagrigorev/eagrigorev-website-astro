---
import type { PostLink } from '@utils/types';
import PostListItem from '@components/feed/PostListItem.astro';
import CallToAction from '@components/call-to-action/CallToAction.astro';

interface Props {
  posts: PostLink[];
  showLog: boolean;
  title: string;
  link?: string | undefined;
  subtitle: string;
}

const { posts, showLog, title, link, subtitle } = Astro.props;
---

<div class="post-list">
  <div class="post-list__title">
    <CallToAction
      isCentered={false}
      link={link}
      title={title}
      subtitle={subtitle}
    />
    {
      showLog ? (
        <p class="post-list__log">
          <span class="post-list__dot">•</span>{' '}
          <a class="post-list__log-link" href="/">
            Under the Log
          </a>
        </p>
      ) : null
    }
  </div>
  <ul class="post-list__items">
    {posts.map((post: PostLink) => <PostListItem post={post} />)}
  </ul>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-40-48);
    max-width: 600px;
    padding-top: var(--space-96-160);
    width: 100%;

    &__title {
      align-items: center;
      display: flex;
      justify-content: space-between;
    }

    &__log {
      @include text-sans-serif-secondary;
      font-size: var(--step-negative-1);
    }

    &__log-link {
      @include link-text-to-muted;
    }

    &__dot {
      color: var(--color-accent);
    }

    &__items {
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
    }
  }
</style>
