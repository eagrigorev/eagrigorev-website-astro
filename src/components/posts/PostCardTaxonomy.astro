---
import type { Post } from '@utils/types';
import { Image } from 'astro:assets';
import { formatDate, generateSlug } from '@scripts/common';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card-taxonomy">
  <div class="post-card-taxonomy__content">
    {
      post.data.featuredImage ? (
        <a
          class="post-card-taxonomy__image-link"
          href={`/${post.data.slug}`}
          tabindex={-1}
        >
          <Image
            class="post-card-taxonomy__image"
            src={post.data.featuredImage.url}
            alt={post.data.featuredImage.alt}
            width="120"
            height="120"
            decoding="async"
            loading="eager"
          />
        </a>
      ) : null
    }
    <div class="post-card-taxonomy__description">
      <div class="post-card-taxonomy__heading">
        <p class="post-card-taxonomy__meta">
          {formatDate(post.data.date)} · <a
            class="post-card-taxonomy__category-link"
            href={`/category/${generateSlug(post.data.category)}`}
            >{post.data.category}</a
          >
        </p>
        <a class="post-card-taxonomy__title-link" href={`/${post.data.slug}`}>
          <h2 class="post-card-taxonomy__title">{post.data.title}</h2>
        </a>
      </div>
      <p class="post-card-taxonomy__excerpt">
        {post.data.description}
      </p>
    </div>
  </div>
</article>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .post-card-taxonomy {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-48-80);
    width: 100%;

    &:not(:last-child) {
      &::after {
        background: var(--color-border);
        content: '';
        display: block;
        height: 1px;
        width: var(--space-80-120);
      }
    }

    &__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
      width: 100%;
    }

    &__image-link {
      @include link-image;
    }

    &__image {
      aspect-ratio: 1/1;
      border: solid 1px var(--color-muted);
      height: var(--space-80-120);
      width: var(--space-80-120);
    }

    &__description {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &__heading {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    &__meta {
      @include text-sans-serif-all-caps;
      font-size: var(--step-negative-2);
    }

    &__category-link {
      @include link-text-to-muted;
    }

    &__title-link {
      @include link-text-to-accent;
    }

    &__title {
      @include heading-serif-primary;
      font-size: var(--step-1);
    }

    &__excerpt {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step-negative-1);
    }
  }
</style>
