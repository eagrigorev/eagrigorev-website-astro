---
import type { Post } from '@utils/types';
import { Image } from 'astro:assets';
import { formatDate, generateSlug } from '@scripts/common';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card">
  <a class="card-media" href={`/${post.data.slug}`} tabindex={-1}>
    <Image
      class="card-media__image"
      src={post.data.featuredImage.url}
      alt={post.data.featuredImage.alt}
      width="420"
      height="560"
      decoding="async"
      loading="eager"
    />
  </a>
  <div class="card-content">
    <div class="card-content__heading">
      <p class="card-content__meta">
        {formatDate(post.data.date)} · <a
          class="card-content__category"
          href={`/category/${generateSlug(post.data.category)}`}
          >{post.data.category}</a
        >
      </p>
      <a class="card-content__title" href={`/${post.data.slug}`}>
        <h2>{post.data.title}</h2>
      </a>
    </div>
    <p class="card-content__excerpt">
      {post.data.description}
    </p>
  </div>
</article>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
  }

  .card-media {
    @include link-image;

    &__image {
      aspect-ratio: 3/4;
      border: solid 1px var(--color-muted);
      height: auto;
      width: 100%;
    }
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;

    &__heading {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    &__meta {
      @include text-sans-serif-all-caps;
      font-size: var(--step-negative-2);
    }

    &__category {
      @include link-text-to-muted;
    }

    &__title {
      @include heading-serif-primary;
      @include link-text-to-accent;
      font-size: var(--step-1);
    }

    &__excerpt {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step-negative-1);
    }
  }
</style>
