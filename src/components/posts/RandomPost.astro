---
import type { Post } from '@utils/types';
import { getRandomPost } from '@scripts/getPosts';

const randomPost: Post | null = await getRandomPost();
const randomPostSlug: string = randomPost ? randomPost.data.slug : '#';
---

<div class="call-to-action">
  <a class="call-to-action__title-link" href={`/${randomPostSlug}`}>
    Get Lost in the Ruins
  </a>
  <p class="call-to-action__description">Read the random post.</p>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .call-to-action {
    align-items: center;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    max-width: fit-content;
    padding-top: var(--space-96-120);
    text-decoration: none;

    &__title-link {
      @include heading-serif-primary;
      @include link-text-to-accent;
      font-size: var(--step-1);
    }

    &__description {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step-negative-1);
    }
  }
</style>
