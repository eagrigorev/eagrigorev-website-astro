---
import type { Post } from '@utils/types';
import { formatDate } from '@scripts/common';

interface Props {
  posts: Post[];
  description: string;
}

const { posts, description } = Astro.props;
---

<section class="post-list">
  <header class="post-list__header">
    <div class="post-list__intro">
      <h2 class="post-list__title">
        <a class="post-list__title-link" href="/the-garden"
          >Explore the Garden</a
        >
      </h2>
      <p class="post-list__description">{description}</p>
    </div>
    <p class="post-list__context">
      <span class="post-list__dot">• </span>
      <a class="post-list__context-link" href="/">The Thicket</a>
    </p>
  </header>
  {
    posts.length ? (
      <ul class="post-list__items" role="list">
        {posts.map((post: Post) => (
          <li class="post-list__item">
            <a class="post-list__link" href={`/${post.data.slug}`}>
              {post.data.title}
            </a>
            <p class="post-list__date">{formatDate(post.data.date)}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="post-list__empty">No posts yet.</p>
    )
  }
</section>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-40-48);
    max-width: var(--container-narrow);
    padding-top: var(--space-96-160);
    width: 100%;

    &__header {
      align-items: center;
      display: flex;
      justify-content: space-between;
    }

    &__intro {
      color: var(--color-text);
      display: flex;
      flex-direction: column;
      max-width: fit-content;
      text-decoration: none;
    }

    &__title {
      @include heading-serif-primary;
      font-size: var(--step-1);
    }

    &__title-link {
      @include link-text-to-accent;
    }

    &__description {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step-negative-1);
    }

    &__context {
      @include text-sans-serif-secondary;
      font-size: var(--step-negative-1);
    }

    &__dot {
      color: var(--color-accent);
    }

    &__context-link {
      @include link-text-to-muted;
    }

    &__items {
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
    }

    &__item {
      align-items: center;
      display: flex;
      justify-content: space-between;
    }

    &__link {
      @include heading-serif-primary;
      @include link-text-to-accent;
      font-size: var(--step-0);
    }

    &__date {
      @include text-sans-serif-secondary;
      font-size: var(--step-negative-1);
    }

    &__empty {
      @include heading-serif-primary;
      font-size: var(--step-0);
    }
  }
</style>
