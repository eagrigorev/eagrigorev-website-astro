---
interface Props {
  isCentered: boolean;
  link: string;
  title: string;
  subtitle: string;
}

const { isCentered, link, title, subtitle } = Astro.props;
---

<a class={`button ${isCentered ? 'centered' : null}`} href={link}>
  <p class="heading-text button__title">{title}</p>
  <p class="text-secondary button__subtitle">{subtitle}</p>
</a>

<style lang="scss">
  .button {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    max-width: fit-content;
    text-decoration: none;

    &__title {
      font-size: var(--fs-l);
    }

    &__subtitle {
      color: var(--color-muted);
      font-size: var(--fs-2xs);
    }
  }

  .centered {
    align-items: center;
  }
</style>
