---
import { generateSlug } from '@scripts/common';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tag-cloud">
  <p class="tag-cloud__title">Tags:</p>
  <ul class="tag-cloud__items" role="list">
    {
      tags.map((tag: string) => (
        <li>
          <a class="tag-cloud__item" href={`/tag/${generateSlug(tag)}`}>
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .tag-cloud {
    align-items: center;
    display: flex;
    gap: var(--space-24-40);
    max-width: var(--container-narrow);
    padding-top: var(--space-96-160);
    width: 100%;

    @media only screen and (max-width: 30rem) {
      align-items: flex-start;
    }

    &__title {
      @include text-sans-serif-secondary;
      font-size: var(--step-negative-1);
    }

    &__items {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-24-40);
      row-gap: var(--space-16-24);
    }

    &__item {
      @include text-sans-serif-secondary;
      @include link-muted-to-text;
      font-size: var(--step-negative-1);
    }
  }
</style>
