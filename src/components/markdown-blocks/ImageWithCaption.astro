---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  caption: string;
  showCaption: boolean;
  width: 600 | 960;
  loading: 'eager' | 'lazy';
}

const { src, caption, showCaption, width, loading } = Astro.props;
---

<figure class="image">
  <Image
    class="image__src"
    src={src}
    alt={caption}
    width={width}
    decoding="async"
    loading={loading}
    quality={80}
    densities={[1, 2]}
    format="avif"
  />
  {showCaption ? (
    <figcaption class="image__caption">{caption}</figcaption>
  ) : null}
</figure>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .image {
    display: flex;
    flex-direction: column;
    gap: var(--space-8-16);

    &__src {
      aspect-ratio: auto;
      border: solid 1px var(--color-muted);
      height: auto;
    }

    &__caption {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step-negative-1);
    }
  }
</style>
