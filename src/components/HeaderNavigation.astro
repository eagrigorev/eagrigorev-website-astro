---
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';
---

<div class="header-nav">
  <a class="header-nav__branding" href="/"
    ><Image
      class="header-nav__avatar"
      src={avatar}
      alt="Evgenii Grigorev"
      width="120"
      height="120"
      decoding="async"
      loading="eager"
    />
    <h1 class="heading-primary header-nav__title">Gardens & Ruins</h1>
  </a>
  <nav>
    <ul class="text-secondary header-nav__menu" role="list">
      <li>
        <a class="header-nav__link" href="/">Explore the Garden</a>
      </li>
      <li>
        <a class="header-nav__link" href="/">Info</a>
      </li>
      <li>
        <a class="header-nav__link" href="/">Goat Tracks</a>
      </li>
    </ul>
  </nav>
</div>

<style lang="scss">
  .header-nav {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
    max-width: 600px;
    padding-top: var(--space-80-160);
    width: 100%;

    &__branding {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
      text-decoration: none;
    }

    &__avatar {
      aspect-ratio: 1/1;
      border: solid 1px var(--color-muted);
      border-radius: 50%;
      height: var(--space-80-120);
      width: var(--space-80-120);
    }

    &__title {
      color: var(--color-text);
      font-size: var(--fs-5xl);
      text-align: center;
    }

    &__menu {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 32px;
      row-gap: 24px;
    }

    &__link {
      color: var(--color-text);
      font-size: var(--fs-2xs);
      text-decoration: none;
      transition: color 0.3s;

      &:focus,
      &:hover {
        color: var(--color-muted);
      }
    }
  }
</style>
