---
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';
---

<div class="navigation-wrapper">
  <a class="link-red navigation-item" href="/">Back to Home</a>
  <a href="/" tabindex="-1"
    ><Image
      class="image"
      src={avatar}
      alt="Evgenii Grigorev"
      width="60"
      height="60"
      decoding="async"
      loading="eager"
    /></a
  >
</div>

<style lang="scss">
  .navigation-wrapper {
    align-items: center;
    display: flex;
    justify-content: space-between;
    max-width: 600px;
    padding-top: 40px;
    width: 100%;
  }

  .image {
    aspect-ratio: 1/1;
    border-radius: 50%;
  }

  .navigation-item {
    font-family: 'Inter Variable', sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
</style>
