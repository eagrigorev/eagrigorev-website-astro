---
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';

const links: string[] = ['Journal', 'About', 'Photography', 'Illustrations'];
---

<div class="navigation-wrapper">
  <a href="/" tabindex="-1"
    ><Image
      class="image"
      src={avatar}
      alt="Evgenii Grigorev"
      width="120"
      height="120"
      decoding="async"
      loading="eager"
    /></a
  >
  <a class="link-red" href="/"><h1 class="title">Gardens & Ruins</h1></a>
  <ul class="navigation-items" role="list">
    {
      links.map((link: string) => (
        <li>
          <a class="link-red navigation-item" href={link.toLowerCase()}>
            {link}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style lang="scss">
  .navigation-wrapper {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 600px;
    padding-top: 160px;
  }

  .image {
    aspect-ratio: 1/1;
    border-radius: 50%;
  }

  .title {
    font-family: 'EB Garamond Variable', serif;
    font-size: 42px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .navigation-items {
    align-items: center;
    display: flex;
    gap: 32px;
  }

  .navigation-item {
    font-family: 'Inter Variable', sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
</style>
