---
import type { Post } from '@utils/types';
import { generateRandomPost } from '@utils/generateRandomPost';
import CallToAction from '@components/call-to-action/CallToAction.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const randomPostLink: string = generateRandomPost(posts);
---

<div class="random-post">
  <CallToAction
    isCentered={true}
    link={randomPostLink}
    title="Get Lost in the Ruins"
    subtitle="Read the random post."
  />
</div>

<style lang="scss">
  .random-post {
    padding-top: var(--space-96-120);
  }
</style>
