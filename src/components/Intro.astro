---
interface Props {
  introType: 'default' | 'category' | 'none';
  introText?: string;
}

const { introType, introText }: Props = Astro.props;

const defaultIntro =
  'My name is Evgenii, welcome. I created this journal in order to cope with anxiety, preserve memories, and reflect on my life. Thank you for stopping by.';

const categoryIntro = `Browsing posts by category: ${introText}`;
---

<div class="intro-wrapper">
  <h2 class="intro">
    {
      introType === 'category'
        ? categoryIntro
        : introType === 'none'
          ? null
          : defaultIntro
    }
  </h2>
  <p class="asterism">⁂</p>
</div>

<style lang="scss">
  .intro-wrapper {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 80px;
    max-width: 600px;
  }

  .intro {
    font-family: 'EB Garamond Variable', serif;
    font-size: 26px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.25;
    text-align: center;
  }

  .asterism {
    color: var(--color-accent-primary);
    font-family: 'EB Garamond Variable', serif;
    font-size: 26px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.25;
  }
</style>
