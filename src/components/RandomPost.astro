---
import type { Post } from '@utils/types';
import TitleWithSubtitle from './TitleWithSubtitle.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;

const randomizerPool = posts.map((post: Post) => ({
  slug: post.data.slug,
  title: post.data.title,
  category: post.data.category,
  description: post.data.description,
}));

const randomNote =
  randomizerPool.length > 0
    ? randomizerPool[Math.floor(Math.random() * randomizerPool.length)]
    : null;

const randomLink = randomNote ? `/${randomNote.slug}` : '#';
---

<div class="random-post">
  <TitleWithSubtitle
    isCentered={true}
    isClickable={true}
    link={randomLink}
    title="Get Lost in the Ruins"
    subtitle="Read the random post."
  />
</div>

<style lang="scss">
  .random-post {
    padding-top: var(--space-96-120);
  }
</style>
