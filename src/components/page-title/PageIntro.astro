---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="intro">
  <h2 class="intro__text">
    {text}
  </h2>
  <p class="intro__asterism">⁂</p>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .intro {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-48-80);
    padding-top: var(--space-80-160);

    &__text {
      @include heading-serif-primary;
      font-size: var(--step-2);
      text-align: center;
    }

    &__asterism {
      @include heading-serif-primary;
      color: var(--color-accent);
      font-size: var(--step-2);
    }
  }
</style>
