---
interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<div class="page-title">
  <h2 class="page-title__text">
    {pageTitle}
  </h2>
  <p class="page-title__asterism">⁂</p>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .page-title {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-48-80);
    padding-top: var(--space-80-160);

    &__text {
      @include heading-serif-primary;
      font-size: var(--step-2);
      text-align: center;
    }

    &__asterism {
      @include heading-serif-primary;
      color: var(--color-accent);
      font-size: var(--step-2);
    }
  }
</style>
