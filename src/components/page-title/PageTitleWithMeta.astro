---
import type { Post } from '@utils/types';
import { formatDate, generateSlug } from '@scripts/common';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<div class="page-title-with-meta">
  <div class="page-title-with-meta__heading">
    <p class="page-title-with-meta__meta">
      {formatDate(post.data.date)} · <a
        class="page-title-with-meta__category-link"
        href={`/category/${generateSlug(post.data.category)}`}
        >{post.data.category}</a
      >
    </p>
    <h2 class="page-title-with-meta__text">
      {post.data.title}
    </h2>
  </div>

  <p class="page-title-with-meta__asterism">⁂</p>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .page-title-with-meta {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-48-80);
    padding-top: var(--space-80-160);

    &__heading {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-8-16);
    }

    &__meta {
      @include text-sans-serif-all-caps;
      font-size: var(--step-negative-2);
      text-align: center;
    }

    &__category-link {
      @include link-text-to-muted;
    }

    &__text {
      @include heading-serif-primary;
      font-size: var(--step-4);
      text-align: center;
    }

    &__asterism {
      @include heading-serif-primary;
      color: var(--color-accent);
      font-size: var(--step-2);
    }
  }
</style>
