---
interface Props {
  isCentered: boolean;
  link: string;
  title: string;
  subtitle: string;
  isClickable: boolean;
}

const { isCentered, link, title, subtitle, isClickable } = Astro.props;
---

<div class={`title ${isCentered ? 'centered' : ''}`}>
  {
    isClickable ? (
      <a class="heading-text title__heading-link" href={link}>
        {title}
      </a>
    ) : (
      <p class="heading-text title__heading">{title}</p>
    )
  }
  <p class="text-secondary title__subtitle">{subtitle}</p>
</div>

<style lang="scss">
  .title {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    max-width: fit-content;
    text-decoration: none;

    &__heading {
      font-size: var(--fs-l);
    }

    &__heading-link {
      color: var(--color-text);
      font-size: var(--fs-l);
      text-decoration: none;
      transition: color 0.3s;

      &:focus,
      &:hover {
        color: var(--color-accent);
      }
    }

    &__subtitle {
      color: var(--color-muted);
      font-size: var(--fs-2xs);
    }
  }

  .centered {
    align-items: center;
  }
</style>
