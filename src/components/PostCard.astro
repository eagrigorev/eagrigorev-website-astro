---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post }: Props = Astro.props;
---

<article class="post-card-wrapper">
  <div class="image-wrapper">
    <a class="clean-link" href={post.data.permalink}>
      <Image
        src={post.data.featuredImage.url}
        alt={post.data.featuredImage.alt}
        width="320"
        height="400"
        decoding="async"
        loading="eager"
      />
    </a>
  </div>
  <div class="description-wrapper">
    <div class="title-wrapper">
      <div class="meta-wrapper">
        <p class="meta">
          {
            new Date(post.data.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </p>
        ·
        <a class="clean-link meta" href={`/${post.data.category.toLowerCase()}`}
          >{post.data.category}</a
        >
      </div>
      <a class="clean-link" href={post.data.permalink}>
        <h3 class="title">{post.data.title}</h3>
      </a>
    </div>
    <p class="description">{post.data.description}</p>
  </div>
</article>

<style lang="scss">
  .post-card-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 320px;
  }

  .image-wrapper {
    border: 1px solid var(--color-secondary);
  }

  .clean-link {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.3s;

    &:focus,
    &:hover {
      color: var(--color-accent-primary);
    }
  }

  .description-wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .title-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta-wrapper {
    align-items: center;
    display: flex;
    gap: 6px;
  }

  .meta {
    font-family: 'Inter Variable', sans-serif;
    font-size: 11px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .title {
    font-family: 'EB Garamond Variable', serif;
    font-size: 21px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.25;
  }

  .description {
    color: var(--color-secondary);
    font-family: 'Inter Variable', sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.05em;
  }
</style>
