---
const links = [
  { name: 'Instagram', url: '/' },
  { name: '·', url: '' },
  { name: 'GitHub', url: '/' },
  { name: '·', url: '' },
  { name: 'RSS Feed', url: '/' },
];

// TODO: Add proper links and links type
---

<div class="footer-nav">
  <div class="footer-nav__content">
    <p>Evgenii Grigorev © 2026</p>
    <nav>
      <ul class="footer-nav__menu" role="list">
        {
          links.map((link) => (
            <li>
              {link.url === '' ? (
                <p class="footer-nav__menu-item">{link.name}</p>
              ) : (
                <a class="footer-nav__menu-item" href={link.url}>
                  {link.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .footer-nav {
    padding-top: var(--space-96-160);

    &__content {
      @include text-sans-serif-secondary;
      align-items: center;
      border-top: solid 1px var(--color-border);
      color: var(--color-muted);
      display: flex;
      font-size: var(--step--1);
      justify-content: space-between;
      padding: 40px 0;

      @media only screen and (width <= 480px) {
        flex-direction: column;
        gap: 16px;
      }
    }

    &__menu {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    &__menu-item {
      @include link-muted-to-text;
    }
  }
</style>
