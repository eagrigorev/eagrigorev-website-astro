---
interface Props {
  isCentered: boolean;
  link?: string | undefined;
  title: string;
  subtitle: string;
}

const { isCentered, link, title, subtitle } = Astro.props;
---

<div class={`title ${isCentered ? 'centered' : ''}`}>
  {
    link ? (
      <a class="title__heading-link" href={link}>
        {title}
      </a>
    ) : (
      <p class="title__heading">{title}</p>
    )
  }
  <p class="title__subtitle">{subtitle}</p>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .title {
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    max-width: fit-content;
    text-decoration: none;

    &__heading {
      @include heading-serif-primary;
      font-size: var(--step-1);
    }

    &__heading-link {
      @include heading-serif-primary;
      @include link-text-to-accent;
      font-size: var(--step-1);
    }

    &__subtitle {
      @include text-sans-serif-secondary;
      color: var(--color-muted);
      font-size: var(--step--1);
    }
  }

  .centered {
    align-items: center;
  }
</style>
