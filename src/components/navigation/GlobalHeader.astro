---
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';

const links = [
  { name: 'Explore the Garden', url: '/' },
  { name: 'Info', url: '/' },
  { name: 'The Thicket', url: '/' },
];

// TODO: type for links, probably move to const
---

<div class="header-nav">
  <a class="header-nav__logo-link" href="/"
    ><Image
      class="header-nav__logo"
      src={avatar}
      alt="Evgenii Grigorev"
      width="120"
      height="120"
      decoding="async"
      loading="eager"
    />
    <h1 class="header-nav__title">Gardens & Ruins</h1>
  </a>
  <nav>
    <ul class="header-nav__menu" role="list">
      {
        links.map((link) => (
          <li>
            <a class="header-nav__menu-item" href={link.url}>
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .header-nav {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
    max-width: 600px;
    padding-top: var(--space-80-160);

    &__logo-link {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
      text-decoration: none;
    }

    &__logo {
      aspect-ratio: 1/1;
      border: solid 1px var(--color-muted);
      border-radius: 50%;
      height: var(--space-80-120);
      width: var(--space-80-120);
    }

    &__title {
      @include heading-serif-all-caps;
      color: var(--color-text);
      font-size: var(--step-4);
      text-align: center;
    }

    &__menu {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 32px;
      row-gap: 24px;
    }

    &__menu-item {
      @include text-sans-serif-secondary;
      @include link-text-to-muted;
      font-size: var(--step--1);
      text-decoration: none;
    }
  }
</style>
