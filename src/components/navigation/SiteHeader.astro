---
import type { NavigationItem } from '@utils/types';
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';
import { HEADER_LINKS, SITE_INFO } from '@utils/const';
---

<div class="site-header">
  <a class="site-logo" href="/"
    ><Image
      class="site-logo__image"
      src={avatar}
      alt={SITE_INFO.AUTHOR}
      width="120"
      height="120"
      decoding="async"
      loading="eager"
    />
    <h1 class="site-logo__title">{SITE_INFO.TITLE}</h1>
  </a>
  <nav>
    <ul class="site-navigation" role="list">
      {
        HEADER_LINKS.map((link: NavigationItem) => (
          <li>
            <a class="site-navigation__item" href={link.url}>
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .site-header {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
    padding-top: var(--space-80-160);
  }

  .site-logo {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
    text-decoration: none;

    &__image {
      aspect-ratio: 1/1;
      border: solid 1px var(--color-muted);
      border-radius: 50%;
      height: var(--space-80-120);
      width: var(--space-80-120);
    }

    &__title {
      @include heading-serif-all-caps;
      color: var(--color-text);
      font-size: var(--step-4);
      text-align: center;
    }
  }

  .site-navigation {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-24-32);
    row-gap: var(--space-16-24);

    &__item {
      @include text-sans-serif-secondary;
      @include link-text-to-muted;
      font-size: var(--step-negative-1);
    }
  }
</style>
