---
import type { NavigationItem } from '@utils/types';
import { Image } from 'astro:assets';
import avatar from '@images/avatar.jpg';
import { HEADER_LINKS, SITE } from '@utils/const';
---

<div class="site-header">
  <a class="site-header__logo-link" href="/"
    ><Image
      class="site-header__logo"
      src={avatar}
      alt="Evgenii Grigorev"
      width="120"
      height="120"
      decoding="async"
      loading="eager"
    />
    <h1 class="site-header__title">{SITE.TITLE}</h1>
  </a>
  <nav>
    <ul class="site-header__menu" role="list">
      {
        HEADER_LINKS.map((link: NavigationItem) => (
          <li>
            <a class="site-header__menu-item" href={link.url}>
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style lang="scss">
  @use '../../styles/partials/typography' as *;

  .site-header {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-16-24);
    padding-top: var(--space-80-160);

    &__logo-link {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--space-16-24);
      text-decoration: none;
    }

    &__logo {
      aspect-ratio: 1/1;
      border: solid 1px var(--color-muted);
      border-radius: 50%;
      height: var(--space-80-120);
      width: var(--space-80-120);
    }

    &__title {
      @include heading-serif-all-caps;
      color: var(--color-text);
      font-size: var(--step-4);
      text-align: center;
    }

    &__menu {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-24-32);
      row-gap: var(--space-16-24);
    }

    &__menu-item {
      @include text-sans-serif-secondary;
      @include link-text-to-muted;
      font-size: var(--step-negative-1);
    }
  }
</style>
